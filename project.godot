; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Battleship"
config/version="0.4.0-alpha"
run/main_scene="res://scenes/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="battleship"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0313726, 0.0627451, 0.0862745, 1)

[audio]

buses/default_bus_layout="uid://bpo32lmmchk31"

[autoload]

AudioManager="*res://scripts/managers/audio_manager.gd"
WindManager="*res://scripts/managers/wind_manager.gd"
UpgradeManager="*res://scripts/managers/upgrade_manager.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
LocaleManager="*res://scripts/managers/locale_manager.gd"
MetaManager="*res://scripts/managers/meta_manager.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/MaruBuri-Regular.otf"

