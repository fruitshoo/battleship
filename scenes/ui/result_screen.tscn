[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

uniform vec4 tint_color : source_color = vec4(0.02, 0.04, 0.07, 0.20);
uniform vec4 vignette_color : source_color = vec4(0.02, 0.04, 0.07, 0.42);
uniform float inner_radius = 0.40;
uniform float outer_radius = 0.78;

void fragment() {
	float edge = smoothstep(inner_radius, outer_radius, distance(UV, vec2(0.5)));
	COLOR = vec4(mix(tint_color.rgb, vignette_color.rgb, edge), tint_color.a + vignette_color.a * edge);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = SubResource("Shader_vignette")
shader_parameter/tint_color = Color(0.02, 0.04, 0.07, 0.2)
shader_parameter/vignette_color = Color(0.02, 0.04, 0.07, 0.42)
shader_parameter/inner_radius = 0.4
shader_parameter/outer_radius = 0.78

