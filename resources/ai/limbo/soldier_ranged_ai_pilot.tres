[gd_resource type="BehaviorTree" format=3]

[ext_resource type="Script" path="res://scripts/ai/limbo/tasks/bt_soldier_select_target.gd" id="1_select"]
[ext_resource type="Script" path="res://scripts/ai/limbo/tasks/bt_soldier_set_mode.gd" id="2_mode"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_soldier_ranged"]

[sub_resource type="BTAction" id="BTAction_select"]
script = ExtResource("1_select")

[sub_resource type="BTAction" id="BTAction_mode"]
script = ExtResource("2_mode")

[sub_resource type="BTSequence" id="BTSequence_root"]
custom_name = "Soldier AI Pilot: ranged profile"
children = [SubResource("BTAction_select"), SubResource("BTAction_mode")]

[resource]
description = "Soldier LimboAI ranged profile. Dedicated ranged crew keeps target selection simple and relies on ranged attacks."
blackboard_plan = SubResource("BlackboardPlan_soldier_ranged")
root_task = SubResource("BTSequence_root")
