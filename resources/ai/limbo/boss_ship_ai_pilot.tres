custom_name = "Boss Ship AI Pilot: acquire target, choose orbit pressure, and publish heavy-volley intent"
children = [SubResource("BTAction_select"), SubResource("BTAction_range_intent"), SubResource("BTAction_pressure"), SubResource("BTAction_stance"), SubResource("BTAction_nav_hint"), SubResource("BTAction_weapon_intent")]

[resource]
description = "Boss-ship LimboAI behavior tree. It selects a player target, classifies range, marks hull-pressure phase, chooses a stance, and publishes navigation plus ranged weapon intent while existing boss helpers still own orbit movement, firing cadence, summons, and collision guards."
blackboard_plan = SubResource("BlackboardPlan_boss")
root_task = SubResource("BTSequence_root")
