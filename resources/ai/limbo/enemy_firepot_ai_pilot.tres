children = [SubResource("BTAction_select"), SubResource("BTAction_range_intent"), SubResource("BTAction_pressure"), SubResource("BTAction_stance"), SubResource("BTAction_nav_hint"), SubResource("BTAction_weapon_intent"), SubResource("BTAction_boarding_intent")]

[resource]
description = "Enemy-firepot LimboAI behavior tree. It selects a player target, classifies range, marks pressure, chooses a stance, and publishes navigation, fire-pot special-attack, and boarding intent while existing ship helpers still own steering, throws, boarding execution, and collision guards."
blackboard_plan = SubResource("BlackboardPlan_firepot")
root_task = SubResource("BTSequence_root")
