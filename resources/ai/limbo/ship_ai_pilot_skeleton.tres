custom_name = "Ship AI Pilot: acquire target, choose stance, and publish navigation/combat hints"
children = [SubResource("BTAction_select"), SubResource("BTAction_range_intent"), SubResource("BTAction_pressure"), SubResource("BTAction_stance"), SubResource("BTAction_nav_hint"), SubResource("BTAction_weapon_intent"), SubResource("BTAction_boarding_intent")]

[resource]
description = "Pilot LimboAI behavior tree for boss and special enemy ships. It selects a player target, classifies distance, marks hull-pressure phase, chooses a stance, and publishes validated navigation, weapon, special attack, and boarding intent hints. Existing ship helpers still own steering, aiming, attacks, boarding execution, and collision guards."
blackboard_plan = SubResource("BlackboardPlan_shv0p")
root_task = SubResource("BTSequence_root")
